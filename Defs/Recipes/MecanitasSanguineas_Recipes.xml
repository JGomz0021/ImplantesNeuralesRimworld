<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>Install_MecanitasSanguineas</defName>
    <label>inyectar mecanitas sanguíneas</label>
    <description>Introduce una colonia de mecanitas médicas en el torrente sanguíneo del paciente.</description>
    <workerClass>Recipe_InstallImplant</workerClass>
    <jobString>Inyectando mecanitas sanguíneas.</jobString>
    <workAmount>4000</workAmount>
    <skillRequirements>
      <Medicine>7</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MecanitasSanguineas_Item</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MecanitasSanguineas_Item</li>
      </thingDefs>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <addsHediff>MecanitasSanguineas</addsHediff>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryRemoveImplantBase">
    <defName>Remove_MecanitasSanguineas</defName>
    <label>purgar mecanitas sanguíneas</label>
    <description>Extrae la colonia de mecanitas sanguíneas del sistema circulatorio.</description>
    <workerClass>Recipe_RemoveImplant</workerClass>
    <jobString>Purgando mecanitas sanguíneas.</jobString>
    <workAmount>3500</workAmount>
    <skillRequirements>
      <Medicine>7</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <removesHediff>MecanitasSanguineas</removesHediff>
  </RecipeDef>

</Defs>
