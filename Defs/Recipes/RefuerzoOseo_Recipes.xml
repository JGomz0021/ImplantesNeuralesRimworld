<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <RecipeDef ParentName="SurgeryInstallImplantBase">
        <defName>Install_Refuerzo_Oseo</defName>
        <label>instalar malla osteorreforzada</label>
        <description>Implanta una malla de filamentos reforzados sobre el esqueleto.</description>
        <workerClass>Recipe_InstallImplant</workerClass>
        <jobString>Instalando malla osteorreforzada.</jobString>
        <workAmount>5000</workAmount>
        <skillRequirements><Medicine>8</Medicine></skillRequirements>
        <ingredients>
            <li><filter><thingDefs><li>RefuerzoOseo_Item</li></thingDefs></filter><count>1</count></li>
            <li><filter><categories><li>Medicine</li></categories></filter><count>3</count></li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs><li>RefuerzoOseo_Item</li></thingDefs>
            <categories><li>Medicine</li></categories>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
        <addsHediff>Refuerzo_Oseo</addsHediff>
    </RecipeDef>
    <RecipeDef ParentName="SurgeryRemoveImplantBase">
        <defName>Remove_Refuerzo_Oseo</defName>
        <label>remover malla osteorreforzada</label>
        <description>Remueve una malla osteorreforzada.</description>
        <workerClass>Recipe_RemoveImplant</workerClass>
        <jobString>Removiendo malla osteorreforzada.</jobString>
        <workAmount>3000</workAmount>
        <skillRequirements><Medicine>6</Medicine></skillRequirements>
        <ingredients><li><filter><categories><li>Medicine</li></categories></filter><count>2</count></li></ingredients>
        <fixedIngredientFilter><categories><li>Medicine</li></categories></fixedIngredientFilter>
        <appliedOnFixedBodyParts><li>Torso</li></appliedOnFixedBodyParts>
        <removesHediff>Refuerzo_Oseo</removesHediff>
    </RecipeDef>
</Defs>
