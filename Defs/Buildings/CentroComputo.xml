<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>CentroComputo</defName>
    <label>centro de cómputo</label>
    <description>Un clúster de servidores, relés y procesadores especializados. Los colonos con un NeuraLink instalado reciben asistencia de cálculo mientras estén a menos de 300 casillas de un centro alimentado. Cada centro soporta hasta 5 conexiones simultáneas.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,4)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <size>(3,2)</size>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>35</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>20</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_RadiusRing">
        <radius>300</radius>
        <color>(0.2, 0.6, 1.0, 0.3)</color>
      </li>
    </comps>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2110</uiOrder>
    <researchPrerequisites>
      <li>ImplantesAvanzados</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

</Defs>
