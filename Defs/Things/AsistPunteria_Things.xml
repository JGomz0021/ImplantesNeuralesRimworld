<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BodyPartBionicBase">
    <defName>ChipAsistentePunteria_Item</defName>
    <label>chip asistente de puntería</label>
    <description>Chip que se implanta en un ojo, realiza cálculos de balística y se los proporciona al usuario para una mejor precisión.</description>

    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <techLevel>Spacer</techLevel>

    <statBases>
      <MarketValue>5000</MarketValue>
      <Mass>0.3</Mass>
      <WorkToMake>4000</WorkToMake>
    </statBases>

    <thingCategories>
      <li>BodyParts</li>
    </thingCategories>

    <costList>
      <ComponentSpacer>4</ComponentSpacer>
      <Plasteel>50</Plasteel>
      <Gold>2</Gold>
      <Silver>2</Silver>
    </costList>

    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedHealthItemBionic</unfinishedThingDef>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <researchPrerequisite>Prosthetics</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>

    <comps>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>ChipAsistentePunteria</hediffDef>
        <bodyPart>Eye</bodyPart>
        <canUpgrade>false</canUpgrade>
      </li>
    </comps>
  </ThingDef>

</Defs>
