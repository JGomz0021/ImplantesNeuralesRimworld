<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>Refuerzo_Oseo</defName>
        <label>refuerzo óseo</label>
        <labelNoun>un refuerzo óseo</labelNoun>
        <description>Una estructura interna de materiales reforzados que fortalece el esqueleto. Reduce el daño contundente, haciendo menos probables las fracturas causadas por impactos.</description>
        <descriptionHyperlinks>
            <ThingDef>RefuerzoOseo_Item</ThingDef>
        </descriptionHyperlinks>
        <hediffClass>Hediff_Implant</hediffClass>
        <defaultLabelColor>(0.8, 0.8, 0.9)</defaultLabelColor>
        <isBad>false</isBad>
        <priceImpact>true</priceImpact>
        <stages>
            <li>
                <statFactors>
                    <!-- HediffDef no admite damageFactors; esta resistencia reduce el daño recibido de forma válida. -->
                    <IncomingDamageFactor>0.85</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <spawnThingOnRemoved>RefuerzoOseo_Item</spawnThingOnRemoved>
    </HediffDef>

</Defs>
