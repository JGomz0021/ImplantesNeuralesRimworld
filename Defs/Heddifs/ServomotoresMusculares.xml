<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef ParentName="ImplantHediffBase">
        <defName>Servomotores_Musculares</defName>
        <label>servomotores miomiméticos</label>
        <labelNoun>unos servomotores miomiméticos</labelNoun>
        <description>Un conjunto de actuadores implantados entre los grupos musculares. Imitan la contracción natural, reducen el esfuerzo y absorben parte de la fuerza de los impactos.</description>
        <descriptionHyperlinks>
            <ThingDef>ServomotoresMusculares_Item</ThingDef>
        </descriptionHyperlinks>
        <hediffClass>Hediff_Implant</hediffClass>
        <defaultLabelColor>(0.8, 0.8, 0.9)</defaultLabelColor>
        <isBad>false</isBad>
        <priceImpact>true</priceImpact>
        <stages>
            <li>
                <statFactors>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                    <MoveSpeed>1.05</MoveSpeed>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>1.10</postFactor>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>1.10</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
        <spawnThingOnRemoved>ServomotoresMusculares_Item</spawnThingOnRemoved>
    </HediffDef>

</Defs>
