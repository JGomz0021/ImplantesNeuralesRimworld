<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="ImplantHediffBase">
    <defName>ChipSubprocesamientoNeural</defName>
    <label>coprocesador neural</label>
    <labelNoun>un coprocesador neural</labelNoun>
    <description>Un coprocesador conectado a los centros ejecutivos del cerebro. Acelera el procesamiento sensorial a costa de un mayor consumo metabólico. En mecanizadores, mejora la coordinación con sus mecas.</description>

    <descriptionHyperlinks>
      <ThingDef>ChipSubprocesamientoNeural_Item</ThingDef>
    </descriptionHyperlinks>

    <hediffClass>Hediff_Implant</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>

    <stages>
      <li>

        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.10</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>

        <hungerRateFactorOffset>0.15</hungerRateFactorOffset>

        <statOffsets>
          <MechBandwidth MayRequire="Ludeon.RimWorld.Biotech">12</MechBandwidth>
          <MechControlGroups MayRequire="Ludeon.RimWorld.Biotech">1</MechControlGroups>
          <WorkSpeedGlobalOffsetMech MayRequire="Ludeon.RimWorld.Biotech">0.10</WorkSpeedGlobalOffsetMech>
          <MechRepairSpeed MayRequire="Ludeon.RimWorld.Biotech">0.15</MechRepairSpeed>
        </statOffsets>

        <statFactors>
          <RestRateMultiplier>1.05</RestRateMultiplier>
        </statFactors>

      </li>
    </stages>

    <spawnThingOnRemoved>ChipSubprocesamientoNeural_Item</spawnThingOnRemoved>
  </HediffDef>

</Defs>
